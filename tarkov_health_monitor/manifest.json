{
  "id": "tarkov_health_monitor",
  "name": "塔科夫血量监控",
  "version": "1.0.4",
  "sdk": "1",
  "author": "鱼汤",
  "homepage": "https://github.com/qtjtrbxqw-ux/Tarkov-Coyote-Plugin",
  "description": "读取塔科夫血量，低于阈值触发郊狼（支持基址/临时地址双模式）\n使用教程：1. 用CE找到血量基址或临时地址；2. 在插件配置中选择模式并填入地址；3. 启用插件，进入游戏自动监控。详细教程请点击主页链接。",
  "entry": "main.py",
  "capabilities": {
    "startup_check": true
  },
  "config_schema": [
    {
      "section": "内存地址",
      "fields": [
        {
          "key": "base_address",
          "type": "text",
          "label": "基址 / 动态地址",
          "default": "0x792F5734",
          "description": "填入基址（如0x00601630）或临时动态地址（如0x7A50D734）"
        },
        {
          "key": "offsets",
          "type": "text",
          "label": "偏移链 (逗号分隔)",
          "default": "",
          "description": "例如 0x10,0x24（使用基址时必填；直接模式时留空）"
        },
        {
          "key": "use_direct",
          "type": "bool",
          "label": "使用直接地址（临时地址模式）",
          "default": false,
          "description": "开启后，直接将 base_address 作为地址读取，忽略偏移链"
        }
      ]
    },
    {
      "section": "触发条件",
      "fields": [
        {
          "key": "threshold",
          "type": "number",
          "label": "生命阈值",
          "default": 30,
          "min": 1,
          "max": 500
        },
        {
          "key": "check_interval",
          "type": "number",
          "label": "检查间隔 (秒)",
          "default": 0.2,
          "min": 0.05,
          "max": 2,
          "step": 0.05
        }
      ]
    },
    {
      "section": "反馈参数",
      "fields": [
        {
          "key": "delta_pct",
          "type": "percent",
          "label": "强度增量 (%)",
          "default": 50
        },
        {
          "key": "duration_s",
          "type": "duration",
          "label": "持续时间 (秒)",
          "default": 1.5
        },
        {
          "key": "preset",
          "type": "preset",
          "label": "波形预设",
          "default": "CS2-受伤"
        },
        {
          "key": "channel",
          "type": "channel",
          "label": "通道",
          "default": "both"
        }
      ]
    }
  ]
}